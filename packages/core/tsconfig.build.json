{
  // The publish build. The dev tsconfig stays noEmit — this one exists so `dist` is
  // only ever produced deliberately, by `npm run build` / prepack, never as a side
  // effect of a typecheck.
  //
  // Composite, because engine and builder reference it: their builds resolve
  // `@dharv44/groundwork-core` through the dev-config `paths` to core's *source*, and
  // the reference is what makes tsc redirect that to core's emitted declarations
  // instead of pulling core's sources into their programs (which violates rootDir).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
