{
  "name": "groundwork",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pick a box on a world map and see what is actually there: real elevation, with the rivers, lakes, climate and vegetation derived from it rather than painted on.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@groundwork/core": "*",
    "@groundwork/engine": "*",
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "geotiff": "^2.1.3",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "three": "^0.170.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.14",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
