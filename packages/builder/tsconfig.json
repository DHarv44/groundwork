{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    // Sibling workspace types from source — see the note in engine's tsconfig.
    "paths": {
      "@dharv44/groundwork-core": ["../core/src/index.ts"],
      "@dharv44/groundwork-engine": ["../engine/src/index.ts"]
    }
  },
  "include": ["src"]
}
